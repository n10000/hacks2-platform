---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

const signals = [
  { number: "01 / Workflows", title: "Repeatable systems.", text: "Practical AI operating models that take a task from idea to a working result.", href: "/workflows/" },
  { number: "02 / Tools", title: "Useful by default.", text: "A sharp filter for the tools worth learning, paying for, or connecting.", href: "/tools/" },
  { number: "03 / Field Notes", title: "Reality, not hype.", text: "Experiments, patterns, and lessons from the moving edge of applied AI.", href: "/notes/" },
];

const protocols = [
  ["Workflow Atlas", "Step-by-step systems for real work.", "/workflows/"],
  ["Tool Index", "The stack behind faster decisions.", "/tools/"],
  ["Field Notes", "Signals collected while building.", "/notes/"],
];

const homepageFaq = [
  {
    question: "Who edits Hacks²?",
    answer: "Nikolay Hristov is the editor of Hacks². He focuses the publication on practical AI workflows, clear tool judgment and systems that can be tested in real work.",
  },
  {
    question: "How does Hacks² evaluate AI tools?",
    answer: "Every recommendation starts with a real use case, practical value, limits, pricing context and whether the tool improves a workflow. Commercial relationships are clearly marked and do not change the verdict.",
  },
  {
    question: "What is in the free Starter Pack?",
    answer: "The Starter Pack includes practical AI workflow templates you can adapt, plus a concise weekly note with workflows, tools and ideas worth testing.",
  },
  {
    question: "What is the AI Business Operations Pack?",
    answer: "It is a €29 one-time purchase with six practical operating systems, copy-ready prompts and templates for founders, operators and small teams.",
  },
];

const homepageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://hacks2.com/#organization",
      name: "Hacks²",
      url: "https://hacks2.com/",
      description: "An editorial AI interface for workflows, tools and automations.",
    },
    {
      "@type": "WebSite",
      "@id": "https://hacks2.com/#website",
      url: "https://hacks2.com/",
      name: "Hacks²",
      publisher: { "@id": "https://hacks2.com/#organization" },
    },
    {
      "@type": "WebPage",
      "@id": "https://hacks2.com/#webpage",
      url: "https://hacks2.com/",
      name: "Hacks² — AI workflows, tools & automations",
      description: "Practical AI workflows, clear tool reviews and automations built for real work.",
      isPartOf: { "@id": "https://hacks2.com/#website" },
      about: { "@id": "https://hacks2.com/#organization" },
    },
    {
      "@type": "FAQPage",
      mainEntity: homepageFaq.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Practical AI workflows, clear tool reviews and automations built for real work — edited by Nikolay Hristov." />
    <link rel="canonical" href="https://hacks2.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hacks²" />
    <meta property="og:title" content="Hacks² — AI workflows, tools & automations" />
    <meta property="og:description" content="Practical AI workflows, clear tool reviews and automations built for real work." />
    <meta property="og:url" content="https://hacks2.com/" />
    <meta property="og:image" content="https://hacks2.com/images/hacks2-workflow-system.jpg" />
    <meta property="og:image:alt" content="Abstract system turning scattered inputs into a repeatable AI workflow" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Hacks² — AI workflows, tools & automations" />
    <meta name="twitter:description" content="Practical AI workflows, clear tool reviews and automations built for real work." />
    <meta name="twitter:image" content="https://hacks2.com/images/hacks2-workflow-system.jpg" />
    <title>Hacks² — AI workflows, tools & automations</title>
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
    <GoogleAnalytics />
  </head>
  <body>
    <main class="page-shell">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Hacks squared home">
          <span class="mark">H²</span>
          <span>Hacks² / Applied AI</span>
        </a>
        <div class="nav-links">
          <a href="#workflows">Workflows</a>
          <a href="/tools/">Tools</a>
          <a href="/notes/">Field Notes</a>
          <a href="/starter-pack/">Starter Pack</a>
          <a class="nav-product-link" href="/business-operations-pack/">Operations Pack</a>
        </div>
        <span class="nav-menu">Index / 001</span>
      </nav>

      <section class="hero">
        <div class="orbit" aria-hidden="true"></div>
        <div class="hero-kicker"><span class="pulse"></span> Live research for useful intelligence</div>
        <h1 class="hero-title">Make AI<br /><span class="offset">do <em>work.</em></span></h1>
        <div class="hero-footer">
          <p class="hero-copy">Hacks² is a field guide for people building an unfair advantage with AI workflows, tools and automation.</p>
          <div class="hero-actions">
            <a class="primary-link" href="/workflows/">Explore workflows <span class="arrow">↘</span></a>
            <a class="secondary-link" href="/roi-calculator/">Estimate automation ROI <span class="arrow">↘</span></a>
            <a class="secondary-link" href="/starter-pack/" data-analytics-event="starter_pack_internal_click" data-analytics-label="Get the free Starter Pack" data-analytics-location="home_hero">Get the free Starter Pack <span class="arrow">↘</span></a>
          </div>
        </div>
      </section>

      <div class="ticker" aria-hidden="true">
        <div class="ticker-track">
          <span>AI workflows</span><span>✳</span><span>Tools with teeth</span><span>✳</span><span>Automate the boring</span><span>✳</span><span>Signal over noise</span><span>✳</span>
          <span>AI workflows</span><span>✳</span><span>Tools with teeth</span><span>✳</span><span>Automate the boring</span><span>✳</span><span>Signal over noise</span><span>✳</span>
        </div>
      </div>

      <section class="product-promo" aria-labelledby="operations-pack-title">
        <div class="product-promo-index"><span>H² / Paid field guide</span><strong>001</strong></div>
        <div class="product-promo-copy">
          <span class="section-tag">AI Business Operations Pack</span>
          <h2 id="operations-pack-title">Turn useful AI<br />into <em>weekly systems.</em></h2>
          <p>Six practical operating systems, copy-ready prompts and working templates for founders, operators and small teams.</p>
        </div>
        <div class="product-promo-action">
          <span>€29 / one-time</span>
          <a href="/business-operations-pack/" data-analytics-event="business_operations_pack_internal_click" data-analytics-label="Explore AI Business Operations Pack" data-analytics-location="home_product_promo">Explore the pack <b>↗</b></a>
        </div>
      </section>

      <section class="section" id="workflows">
        <span class="section-tag">The operating system</span>
        <h2 class="section-heading">Less prompt theatre.<br />More output.</h2>
        <div class="signal-grid">
          {signals.map((signal) => (
            <a class="signal" href={signal.href}>
              <span class="signal-number">{signal.number}</span>
              <div>
                <h3>{signal.title}</h3>
                <p>{signal.text}</p>
              </div>
              <span>↗</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section" id="tools">
        <span class="section-tag">A useful starting point</span>
        <h2 class="section-heading">The H² protocol.</h2>
        <div class="protocol">
          <p class="protocol-aside">We document what survives contact with actual work: clear inputs, durable processes and outcomes you can measure.</p>
          <div class="protocol-list">
            {protocols.map(([title, description, href]) => (
              <a class="protocol-item" href={href}>
                <h3>{title}</h3>
                <span>{description}</span>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="proof-case" aria-labelledby="proof-case-title">
        <div>
          <span class="section-tag">A system, not a magic prompt</span>
          <h2 id="proof-case-title">From scattered input<br />to a <em>decision-ready brief.</em></h2>
        </div>
        <div class="proof-case-grid">
          <article>
            <span>Before</span>
            <p>Client notes, emails and call transcripts live in separate places. The next step relies on someone remembering what matters.</p>
          </a>
          <article>
            <span>System</span>
            <p>Capture the source material, ask AI to structure it against a fixed brief, then keep a human review before anything is sent.</p>
          </a>
          <article>
            <span>Target outcome</span>
            <p>One reviewable brief, clear owners and a repeatable handoff — with the aim of saving around 25 minutes on every qualified client brief.</p>
          </a>
        </div>
        <a class="proof-case-link" href="/workflows/ai-client-brief-to-delivery/">See the client brief workflow <span>↗</span></a>
      </section>

      <section class="editorial-trust" aria-labelledby="editorial-trust-title">
        <div class="editorial-intro">
          <span class="section-tag">Who is behind this</span>
          <h2 id="editorial-trust-title">Edited for<br /><em>applied intelligence.</em></h2>
          <p><strong>Nikolay Hristov</strong> is the editor of Hacks². The publication focuses on the practical layer of AI: turning useful tools into clear, reusable workflows for real work.</p>
          <p class="editorial-updated">Editorial standards reviewed · Updated 1 August 2026</p>
        </div>
        <div class="editorial-principles" aria-label="Editorial principles">
          <article><span>01</span><h3>Useful over loud</h3><p>We prioritize specific use cases and durable processes over prompt theatre and vague claims.</p></a>
          <article><span>02</span><h3>Limits included</h3><p>Tools are assessed for practical value, pricing context and the trade-offs that matter before you adopt them.</p></a>
          <article><span>03</span><h3>Clear commercial lines</h3><p>Affiliate relationships are marked. They never decide a recommendation.</p></a>
        </div>
        <a class="editorial-disclosure-link" href="/disclosure/">Read the editorial &amp; affiliate disclosure <span>↗</span></a>
      </section>

      <section class="home-faq" aria-labelledby="home-faq-title">
        <div>
          <span class="section-tag">Quick answers</span>
          <h2 id="home-faq-title">Know the<br /><em>operating model.</em></h2>
        </div>
        <div class="home-faq-list">
          {homepageFaq.map((item) => (
            <details>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="closing" id="notes">
        <div>
          <p>H² / issue zero</p>
          <h2>Build smarter.<br /><span>Ship stranger.</span></h2>
          <a class="primary-link" href="mailto:info@hacks2.com">Get the first signal <span class="arrow">↗</span></a>
        </div>
      </section>

      <section class="newsletter-cta" aria-labelledby="newsletter-title">
  <span class="section-tag">H² Signal / Weekly</span>
  <div>
    <h2 id="newsletter-title">Useful AI.<br />No noise.</h2>
    <p>One concise weekly note with practical workflows, tools and ideas worth testing.</p>
  </div>
  <a class="newsletter-button" href="/starter-pack/" data-analytics-event="starter_pack_internal_click" data-analytics-label="Get the free Starter Pack" data-analytics-location="home_newsletter">
    Get the free Starter Pack <span>↘</span>
  </a>
</section>

          <footer class="footer">
        <span>© 2026 Hacks²</span>
        <span>Built for applied intelligence</span>
        <a href="/disclosure/">Editorial disclosure</a>
      </footer>
    </main>
  </body>
</html>


