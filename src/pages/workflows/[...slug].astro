---
import "../../styles/global.css";
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import { getCollection, render } from "astro:content";
import ResearchDecisionBrief from "../../components/ResearchDecisionBrief.astro";

export async function getStaticPaths() {
  const workflows = await getCollection("workflows");

  return workflows.map((workflow) => ({
    params: { slug: workflow.id },
    props: { workflow },
  }));
}

const { workflow } = Astro.props;
const { Content } = await render(workflow);
const relatedWorkflows = (await getCollection("workflows"))
  .filter((item) => item.id !== workflow.id && item.data.category === workflow.data.category)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 3);
const publishedDate = workflow.data.publishedAt.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
const canonicalUrl = new URL(`/workflows/${workflow.id}/`, Astro.site);
const socialImageUrl = new URL("/images/hacks2-workflow-system.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={workflow.data.description} />
    <title>{workflow.data.title} — Workflow — Hacks²</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Hacks²" />
    <meta property="og:title" content={`${workflow.data.title} — Hacks²`} />
    <meta property="og:description" content={workflow.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Abstract system turning scattered inputs into a repeatable workflow" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${workflow.data.title} — Hacks²`} />
    <meta name="twitter:description" content={workflow.data.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Abstract system turning scattered inputs into a repeatable workflow" />
    <GoogleAnalytics />
  </head>
  <body>
    <main class="page-shell">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Hacks squared home">
          <span class="mark">H²</span>
          <span>Hacks² / Applied AI</span>
        </a>
        <div class="nav-links">
          <a href="/workflows/">Workflows</a>
          <a href="/tools/">Tools</a>
          <a href="/notes/">Field Notes</a>
          <a class="nav-product-link" href="/business-operations-pack/">Operations Pack</a>
        </div>
        <span class="nav-menu">Workflow / 001</span>
      </nav>

      <article class="article-shell">
        <header class="article-header">
          <span class="section-tag">{workflow.data.category} / {workflow.data.readTime}</span>
          <h1>{workflow.data.title}</h1>
          <p>{workflow.data.description}</p>
          <div class="article-meta">
            <span>Published {publishedDate}</span>
            <span>H² operating workflow</span>
          </div>
        </header>

        <figure class="workflow-visual">
          <img src="/images/hacks2-workflow-system.jpg" alt="Abstract system turning scattered inputs into a repeatable workflow" width="1730" height="909" loading="eager" />
          <figcaption>From scattered inputs to a repeatable system.</figcaption>
        </figure>

        <aside class="article-rail">
          <div>
            <span>What this gives you</span>
            <ul>{workflow.data.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
          </div>
          <div>
            <span>Suggested stack</span>
            <p>{workflow.data.tools.join(" · ")}</p>
          </div>
        </aside>

        <div class="article-content">
          <Content />

          {workflow.data.template === "research-decision-brief" ? (
            <ResearchDecisionBrief />
          ) : (
            <section class="workflow-template" aria-labelledby="template-title">
              <span class="section-tag">Copy this template</span>
              <h2 id="template-title">Start small.<br />Make it repeatable.</h2>
              <ol>
                <li><strong>Input:</strong> Define the job, audience, constraints and source material.</li>
                <li><strong>Draft:</strong> Use AI for structure and options, not the final unchecked answer.</li>
                <li><strong>Review:</strong> Check facts, judgment, tone and the consequence of a mistake.</li>
                <li><strong>Deliver:</strong> Put the useful output where work actually happens.</li>
                <li><strong>Learn:</strong> Record what improved, failed or should change next time.</li>
              </ol>
            </section>
          )}

          <section class="workflow-subscribe" aria-labelledby="signal-title">
            <span class="section-tag">Free field kit / Issue 001</span>
            <h2 id="signal-title">Make the workflow yours.</h2>
            <p>Get the H² AI Workflow Starter Pack: five practical systems, prompts and decision frameworks to turn useful AI ideas into repeatable work.</p>
            <a href="/starter-pack/" data-analytics-event="starter_pack_internal_click" data-analytics-label="Get the free Starter Pack" data-analytics-location="workflow_article">Get the free Starter Pack <span>↘</span></a>
          </section>

          <section class="workflow-product-cta" aria-labelledby="operations-pack-cta-title">
            <span class="section-tag">H² Paid field guide / 001</span>
            <h2 id="operations-pack-cta-title">Ready to make it<br /><em>operational?</em></h2>
            <p>The AI Business Operations Pack turns the core workflow into six reusable systems, prompts and templates for small-business operations.</p>
            <a href="/business-operations-pack/" data-analytics-event="business_operations_pack_internal_click" data-analytics-label="Explore AI Business Operations Pack" data-analytics-location="workflow_article">Explore the €29 Operations Pack <span>↗</span></a>
          </section>
        </div>
      </article>

      {relatedWorkflows.length > 0 && (
        <section class="article-next" aria-labelledby="related-workflows-title">
          <span class="section-tag">Continue the system</span>
          <h2 id="related-workflows-title">Related workflows</h2>
          <div class="related-workflow-links">
            {relatedWorkflows.map((related) => (
              <a href={`/workflows/${related.id}/`}>
                <span>{related.data.category}</span>
                {related.data.title} <b aria-hidden="true">↗</b>
              </a>
            ))}
          </div>
        </section>
      )}

      <section class="article-next">
        <span class="section-tag">Keep building</span>
        <a href="/workflows/">Explore all workflows <span>↗</span></a>
      </section>

      <footer class="footer">
        <span>© 2026 Hacks²</span>
        <span>Built for applied intelligence</span>
        <a href="/disclosure/">Editorial disclosure</a>
      </footer>
    </main>
  </body>
</html>
