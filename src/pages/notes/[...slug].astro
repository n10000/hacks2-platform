---
import "../../styles/global.css";
import GoogleAnalytics from "../../components/GoogleAnalytics.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
const { Content } = await render(note);
const publishedDate = note.data.publishedAt.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
const canonicalUrl = new URL(`/notes/${note.id}/`, Astro.site);
const socialImageUrl = new URL("/images/hacks2-workflow-system.jpg", Astro.site);
const socialImageAlt = "Abstract system turning scattered inputs into a repeatable AI workflow";
const publishedDateIso = note.data.publishedAt.toISOString();
const modifiedDateIso = (note.data.updatedAt ?? note.data.publishedAt).toISOString();

const articleSchema = {
  "@type": "Article",
  "@id": `${canonicalUrl.toString()}#article`,
  headline: note.data.title,
  description: note.data.description,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl.toString(),
  },
  url: canonicalUrl.toString(),
  image: {
    "@type": "ImageObject",
    url: socialImageUrl.toString(),
    width: 1730,
    height: 909,
  },
  datePublished: publishedDateIso,
  dateModified: modifiedDateIso,
  articleSection: note.data.category,
  author: {
    "@id": "https://hacks2.com/#nikolay-hristov",
  },
  publisher: {
    "@type": "Organization",
    "@id": "https://hacks2.com/#organization",
    name: "Hacks²",
    url: "https://hacks2.com/",
  },
};

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl.toString()}#breadcrumb`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Hacks²",
      item: "https://hacks2.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Field Notes",
      item: "https://hacks2.com/notes/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: note.data.title,
      item: canonicalUrl.toString(),
    },
  ],
};

const organizationSchema = {
  "@type": "Organization",
  "@id": "https://hacks2.com/#organization",
  name: "Hacks²",
  url: "https://hacks2.com/",
  description: "An editorial AI interface for workflows, tools and automations.",
};

const personSchema = {
  "@type": "Person",
  "@id": "https://hacks2.com/#nikolay-hristov",
  name: "Nikolay Hristov",
  url: "https://hacks2.com/",
  jobTitle: "Editor",
  worksFor: { "@id": "https://hacks2.com/#organization" },
  knowsAbout: ["AI workflows", "automation", "business AI tools"],
};

const websiteSchema = {
  "@type": "WebSite",
  "@id": "https://hacks2.com/#website",
  url: "https://hacks2.com/",
  name: "Hacks²",
  publisher: { "@id": "https://hacks2.com/#organization" },
  creator: { "@id": "https://hacks2.com/#nikolay-hristov" },
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [organizationSchema, personSchema, websiteSchema, articleSchema, breadcrumbSchema],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={note.data.description} />
    <title>{note.data.title} — Field Notes — Hacks²</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Hacks²" />
    <meta property="og:title" content={`${note.data.title} — Hacks²`} />
    <meta property="og:description" content={note.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="article:published_time" content={publishedDateIso} />
    <meta property="article:modified_time" content={modifiedDateIso} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${note.data.title} — Hacks²`} />
    <meta name="twitter:description" content={note.data.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <GoogleAnalytics />
  </head>
  <body>
    <main class="page-shell">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Hacks squared home">
          <span class="mark">H²</span>
          <span>Hacks² / Applied AI</span>
        </a>
        <div class="nav-links">
          <a href="/workflows/">Workflows</a>
          <a href="/tools/">Tools</a>
          <a href="/notes/">Field Notes</a>
          <a href="/starter-pack/">Starter Pack</a>
          <a class="nav-product-link" href="/business-operations-pack/">Operations Pack</a>
        </div>
        <span class="nav-menu">Note / 001</span>
      </nav>

      <article class="article-shell">
        <header class="article-header">
          <span class="section-tag">{note.data.category} / {note.data.readTime}</span>
          <h1>{note.data.title}</h1>
          <p>{note.data.description}</p>
          <div class="article-meta">
            <span>Published {publishedDate}</span>
            <span>H² field note</span>
          </div>
        </header>

        <aside class="article-rail">
          <div>
            <span>Field note</span>
            <p>Short observations from real AI work — collected to improve the next decision.</p>
          </div>
        </aside>

        <div class="article-content">
          <Content />

          {note.data.relatedWorkflow && (
            <aside class="related-workflow" aria-label="Related workflow">
              <span class="section-tag">Put this into practice</span>
              <h2>{note.data.relatedWorkflow.title}</h2>
              <p>{note.data.relatedWorkflow.description}</p>
              <a href={note.data.relatedWorkflow.href}>Open workflow <span>↗</span></a>
            </aside>
          )}
        </div>
      </article>

      <section class="article-next">
        <span class="section-tag">More signals</span>
        <a href="/notes/">Read the field notes <span>↗</span></a>
      </section>

      <footer class="footer">
        <span>© 2026 Hacks²</span>
        <span>Built for applied intelligence</span>
        <a href="/disclosure/">Editorial disclosure</a>
      </footer>
    </main>
  </body>
</html>
