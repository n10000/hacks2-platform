---
import "../styles/global.css";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

const inclusions = [
  {
    number: "01",
    title: "The operating loop",
    copy: "A repeatable brief-to-decision loop that makes useful AI work easier to improve and reuse.",
  },
  {
    number: "02",
    title: "Prompt architecture",
    copy: "A clear structure for giving AI the context, constraints and output shape a task actually needs.",
  },
  {
    number: "03",
    title: "Research to decision",
    copy: "A practical way to turn scattered sources into a short brief with evidence, trade-offs and a next action.",
  },
  {
    number: "04",
    title: "Automation ROI",
    copy: "A simple go/no-go check for deciding whether an automation saves enough time to be worth maintaining.",
  },
  {
    number: "05",
    title: "Weekly review ritual",
    copy: "A 20-minute review for keeping the AI patterns that work and stopping the ones that do not.",
  },
];

const starterTemplates = [
  {
    number: "01",
    title: "Brief the task",
    copy: "Use this before opening a chat or automation builder.",
    prompt: "Task: [what needs to be done]\nAudience: [who will use the result]\nContext: [facts, files or links]\nConstraints: [time, format, tone, exclusions]\nUseful output: [what good looks like]",
  },
  {
    number: "02",
    title: "Check the result",
    copy: "Make the human review explicit instead of assuming the first draft is ready.",
    prompt: "Review the draft for:\n- unsupported claims or missing evidence\n- unclear assumptions and open questions\n- tone, format and audience fit\n- actions that need human approval\nReturn: issues, fixes and a ready/not-ready decision.",
  },
  {
    number: "03",
    title: "Keep the learning",
    copy: "Record one small improvement so the workflow gets better next time.",
    prompt: "Weekly workflow review:\nWhat repeated task did we test?\nWhat saved time or improved quality?\nWhere did the output need correction?\nWhat one change will we keep next week?\nOwner: [name]  Review date: [date]",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Get the free AI Workflow Starter Pack: practical frameworks for finding, testing and improving AI-supported work."
    />
    <link rel="canonical" href="https://hacks2.com/starter-pack/" />
    <title>AI Workflow Starter Pack — Hacks²</title>
    <GoogleAnalytics />
  </head>
  <body>
    <main class="page-shell starter-page">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Hacks squared home">
          <span class="mark">H²</span>
          <span>Hacks² / Applied AI</span>
        </a>
        <div class="nav-links">
          <a href="/workflows/">Workflows</a>
          <a href="/tools/">Tools</a>
          <a href="/notes/">Field Notes</a>
          <a href="/starter-pack/">Starter Pack</a>
          <a class="nav-product-link" href="/business-operations-pack/">Operations Pack</a>
        </div>
        <span class="nav-menu">Starter / 001</span>
      </nav>

      <header class="starter-hero">
        <p class="hero-kicker"><span class="pulse"></span> Free resource / practical AI</p>
        <div class="starter-hero-grid">
          <div>
            <p class="starter-overline">H² Workflow Starter Pack</p>
            <h1>MAKE AI<br />USEFUL<br /><em>THIS WEEK.</em></h1>
          </div>
          <div class="starter-hero-copy">
            <p>
              A concise field guide for turning scattered AI experiments into one
              useful workflow — with clearer inputs, a sensible human check and a
              result you can actually measure.
            </p>
            <a
              class="starter-primary-link"
              href="https://hacks2.substack.com/subscribe"
              target="_blank"
              rel="noopener noreferrer"
              data-analytics-event="starter_pack_cta_click"
              data-analytics-label="Get the free AI Workflow Starter Pack"
              data-analytics-location="starter_pack_hero"
            >
              Get the free pack <span>↗</span>
            </a>
            <small>Free via H² Signal. One concise weekly note; unsubscribe anytime.</small>
          </div>
        </div>
      </header>

      <section class="starter-for" aria-labelledby="starter-for-title">
        <span class="section-tag">Built for real work</span>
        <h2 id="starter-for-title">NOT ANOTHER<br /><em>TOOL LIST.</em></h2>
        <div>
          <p>
            The pack is for people who already know AI can help, but want a calmer
            way to choose where it belongs in their day-to-day work.
          </p>
          <ul>
            <li>Operators and founders reducing repeat admin</li>
            <li>Teams improving research, briefs and client delivery</li>
            <li>Professionals testing AI without adding unnecessary complexity</li>
          </ul>
        </div>
      </section>

      <section class="starter-inclusions" aria-labelledby="inclusions-title">
        <div class="starter-section-heading">
          <span class="section-tag">Inside the pack</span>
          <h2 id="inclusions-title">FIVE SYSTEMS.<br /><em>ONE USEFUL START.</em></h2>
        </div>

        <div class="starter-inclusion-grid">
          {inclusions.map((item) => (
            <article>
              <span>{item.number}</span>
              <h3>{item.title}</h3>
              <p>{item.copy}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="starter-process" aria-labelledby="process-title">
        <div>
          <span class="section-tag">How to use it</span>
          <h2 id="process-title">PICK ONE<br /><em>REPEATED TASK.</em></h2>
        </div>
        <ol>
          <li><span>01</span><p>Choose work that happens often enough to be worth improving.</p></li>
          <li><span>02</span><p>Define the useful output and the points where a person needs to check it.</p></li>
          <li><span>03</span><p>Run one small test, compare the result and keep only what reduces friction.</p></li>
        </ol>
      </section>

      <section class="starter-templates" aria-labelledby="templates-title">
        <div class="starter-template-heading">
          <span class="section-tag">Copy-ready starting points</span>
          <h2 id="templates-title">USE ONE<br /><em>RIGHT NOW.</em></h2>
          <p>Copy a block into your next AI session, replace the brackets and keep a person responsible for the final decision.</p>
        </div>
        <div class="starter-template-grid">
          {starterTemplates.map((template) => (
            <article class="starter-template-card">
              <span>{template.number}</span>
              <h3>{template.title}</h3>
              <p>{template.copy}</p>
              <pre>{template.prompt}</pre>
            </article>
          ))}
        </div>
      </section>

      <section class="starter-final">
        <span class="section-tag">Start small. Keep what works.</span>
        <h2>YOUR NEXT<br />USEFUL<br /><em>WORKFLOW.</em></h2>
        <p>Get the Starter Pack, then use it on one task that matters this week.</p>
        <a class="starter-product-link" href="/business-operations-pack/" data-analytics-event="business_operations_pack_internal_click" data-analytics-label="Explore AI Business Operations Pack" data-analytics-location="starter_pack_final">Need a deeper operating layer? Explore the Operations Pack <span>↗</span></a>
        <a
          class="starter-final-button"
          href="https://hacks2.substack.com/subscribe"
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="starter_pack_cta_click"
          data-analytics-label="Get the free AI Workflow Starter Pack"
          data-analytics-location="starter_pack_final"
        >
          Send me the free pack <span>↗</span>
        </a>
      </section>

      <footer class="footer">
        <span>© 2026 Hacks²</span>
        <span>Built for applied intelligence</span>
        <a href="/disclosure/">Editorial disclosure</a>
      </footer>
    </main>
  </body>
</html>
