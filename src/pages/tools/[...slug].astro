---
import "../../styles/global.css";
import "../../components/GoogleAnalytics.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const tools = await getCollection("tools");

  return tools.map((tool) => ({
    params: { slug: tool.id },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const { Content } = await render(tool);
// Keep only approved, live partner URLs here. Unapproved tools use their official website URL.
const affiliateLinks: Record<string, string | undefined> = {
  make: "https://www.make.com/en/register?pc=hacks2",
};
const affiliateUrl = affiliateLinks[tool.id];
const outboundUrl = affiliateUrl ?? tool.data.website;
const linkLabel = affiliateUrl ? "Affiliate link" : "Official website";
const canonicalUrl = new URL(`/tools/${tool.id}/`, Astro.site);
const socialImageUrl = new URL("/images/hacks2-workflow-system.jpg", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={tool.data.description} />
    <title>{tool.data.title} — Tools — Hacks²</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Hacks²" />
    <meta property="og:title" content={`${tool.data.title} — Tools — Hacks²`} />
    <meta property="og:description" content={tool.data.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1730" />
    <meta property="og:image:height" content="909" />
    <meta property="og:image:alt" content="Abstract system turning scattered inputs into a repeatable workflow" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${tool.data.title} — Tools — Hacks²`} />
    <meta name="twitter:description" content={tool.data.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="Abstract system turning scattered inputs into a repeatable workflow" />
    <GoogleAnalytics />
  </head>
  <body>
    <main class="page-shell">
      <nav class="nav" aria-label="Primary navigation">
        <a class="brand" href="/" aria-label="Hacks squared home">
          <span class="mark">H²</span>
          <span>Hacks² / Applied AI</span>
        </a>
        <div class="nav-links">
          <a href="/workflows/">Workflows</a>
          <a href="/tools/">Tools</a>
          <a href="/notes/">Field Notes</a>
          <a class="nav-product-link" href="/business-operations-pack/">Operations Pack</a>
        </div>
        <span class="nav-menu">Tool / 001</span>
      </nav>

      <article class="article-shell">
        <header class="article-header">
          <span class="section-tag">{tool.data.category} / Tool index</span>
          <h1>{tool.data.title}</h1>
          <p>{tool.data.description}</p>
          <div class="article-meta">
            <span>{tool.data.pricing}</span>
            <span>H² tool review</span>
          </div>
        </header>

        <aside class="article-rail">
          <div>
            <span>Verdict</span>
            <p>{tool.data.verdict}</p>
          </div>
          <div>
            <span>{linkLabel}</span>
            <p><a class="inline-link" href={outboundUrl} target="_blank" rel="sponsored noreferrer" data-analytics-event="tool_outbound_click" data-analytics-label={tool.data.title} data-analytics-location="tool_article">Visit tool ↗</a></p>
          </div>
        </aside>

        <div>
          {(tool.data.bestFor.length > 0 || tool.data.watchOutFor) && <section class="tool-snapshot" aria-label={`${tool.data.title} quick summary`}>
            {tool.data.bestFor.length > 0 && <div>
              <span>Best for</span>
              <ul>{tool.data.bestFor.map((item) => <li>{item}</li>)}</ul>
            </div>}
            {tool.data.watchOutFor && <div>
              <span>Watch out for</span>
              <p>{tool.data.watchOutFor}</p>
            </div>}
          </section>}
          <p class="affiliate-notice">{affiliateUrl ? "This page contains an affiliate link. Hacks² may earn a commission at no extra cost to you." : "This is a direct link to the official website. Hacks² does not currently earn a commission from this link."} <a href="/disclosure/">Read the policy ↗</a></p>
          <div class="article-content"><Content /></div>
        </div>
      </article>

      <section class="article-next">
        <span class="section-tag">Keep exploring</span>
        <a href="/tools/">Return to the tool index <span>↗</span></a>
      </section>

      <footer class="footer">
        <span>© 2026 Hacks²</span>
        <span>Built for applied intelligence</span>
        <a href="/disclosure/">Editorial disclosure</a>
      </footer>
    </main>
  </body>
</html>
